{
  "name": "my-dictionary",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "api": "node server/dictionaryProxy.js",
    "web": "node scripts/start-web.js",
    "build:web": "expo export --platform web",
    "start:prod": "node server/dictionaryProxy.js",
    "typecheck": "tsc --noEmit",
    "test:navigation": "playwright test e2e/navigation.spec.js --config=playwright.config.js --workers=1",
    "test:e2e": "npm run build:web && playwright test --config=playwright.config.js --workers=1",
    "test:review": "node scripts/test-review-session.js && node scripts/test-review-history.js && node scripts/test-review-layout.js",
    "test:owl": "node scripts/test-owl-mascot.js",
    "test:phase1": "node scripts/test-phase1.js",
    "test:server": "node scripts/test-server-hardening.js",
    "test:phase3": "node scripts/test-phase3.js",
    "test:release": "npm run build:web && node scripts/test-release-smoke.js",
    "release:smoke": "node scripts/release-smoke.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-linear-gradient": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
