{
  "expo": {
    "name": "My Dictionary",
    "slug": "my-dictionary",
    "owner": "tanukohlis-team",
    "scheme": "mydictionary",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/app-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tanukohli.mydictionary",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E7",
        "foregroundImage": "./src/assets/app-icon-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "My Dictionary",
      "description": "A local-first dictionary and vocabulary learning app."
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/withSecureAndroid.js",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/app-icon-foreground.png",
          "imageWidth": 200,
          "backgroundColor": "#FFF8E7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b875fd2d-0b12-4b7e-aff9-30dcb75ec215"
      }
    }
  }
}
