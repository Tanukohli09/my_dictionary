# Client setting. For a single-server deployment, keep this same-origin.
EXPO_PUBLIC_DICTIONARY_API_URL=/api/dictionary

# Set this to true only for development when the provider is unavailable.
# Production lookups must use the configured dictionary provider.
EXPO_PUBLIC_OFFLINE_FALLBACK=false

# Dictionary proxy/server settings.
PORT=3000
HOST=0.0.0.0
DICTIONARY_ENV=development
DICTIONARY_WEB_ROOT=./dist
# Set to true only after provider quality, quota, terms, licensing, and attribution are approved.
# DICTIONARY_PROVIDER_APPROVED=true
# Datamuse provides definitions without a client-side key. The proxy normalizes its response.
DICTIONARY_PROVIDER=datamuse
DICTIONARY_UPSTREAM_URL=https://api.datamuse.com/words
DICTIONARY_FALLBACK_PROVIDER=wiktionary
DICTIONARY_FALLBACK_URL=https://en.wiktionary.org/api/rest_v1/page/definition
# Set to false if the approved launch policy does not permit this fallback.
# DICTIONARY_ENABLE_WIKTIONARY_FALLBACK=false
# Use the exact deployed web origin in production; * is convenient for local development.
DICTIONARY_ALLOWED_ORIGIN=*
# Enable only when the service is always reached through HTTPS.
DICTIONARY_HSTS=false
# Optional protected metrics endpoint. Keep this value server-side and private.
# DICTIONARY_METRICS_TOKEN=replace-with-a-long-random-token
# The word used by /ready for a live upstream provider check.
DICTIONARY_HEALTH_WORD=the

# To use the Free Dictionary API instead, use these values:
# DICTIONARY_PROVIDER=dictionaryapi
# DICTIONARY_UPSTREAM_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# Optional provider authentication. Keep secrets on the server, never in Expo client variables.
# DICTIONARY_API_KEY=replace-with-provider-key
# DICTIONARY_API_KEY_HEADER=X-API-Key
# DICTIONARY_UPSTREAM_HEADERS={"Authorization":"Bearer replace-with-provider-token"}

# Optional protection/tuning values.
# DICTIONARY_REQUEST_TIMEOUT_MS=5000
# DICTIONARY_CACHE_TTL_MS=3600000
# DICTIONARY_RATE_LIMIT_MAX=60
# DICTIONARY_RATE_LIMIT_WINDOW_MS=60000
# Set this only when a trusted reverse proxy overwrites X-Forwarded-For.
# DICTIONARY_TRUST_PROXY=true
